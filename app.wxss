page{background:#eaf5fb;color:#16354d;font-family:sans-serif;font-size:28rpx}button{font-size:26rpx;border-radius:12rpx}button::after{border:0}.primary{background:#205b87;color:white}.yellow{background:#ffcf55;color:#16354d}.wrap{padding:32rpx}.title{font-weight:bold;font-size:55rpx;line-height:1.35}.subtitle{color:#557085;font-size:24rpx;margin:18rpx 0 28rpx;line-height:1.7}.panel{background:white;border-radius:20rpx;padding:28rpx;margin-bottom:24rpx}.section-title{font-size:32rpx;font-weight:bold;margin-bottom:22rpx}.row{display:flex;gap:12rpx;margin:16rpx 0;align-items:center}.row button{flex:1;margin:0}.tabs{display:flex;gap:12rpx;margin:25rpx 0}.tabs button{flex:1;margin:0}.field{border:1rpx solid #cadae5;border-radius:10rpx;padding:18rpx;margin:12rpx 0 20rpx}.hint{font-size:22rpx;color:#557085;line-height:1.7}.slots{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14rpx}.slot{border:2rpx solid #9bb6cb;border-radius:12rpx;background:#f7fbfd;padding:17rpx;text-align:center}.slot-number{font-size:35rpx;font-weight:bold}.umbrella{font-size:68rpx;color:#205b87;line-height:1.5}.slot button{font-size:23rpx;padding:0;margin-top:15rpx}.status{font-size:22rpx;color:#246d56}.record{padding:20rpx 0;border-bottom:1rpx solid #e4edf2}.record:last-child{border:0}.record-title{font-weight:bold;margin-bottom:10rpx}.score{font-size:42rpx;font-weight:bold}.warning{color:#9a511c}.empty{color:#557085;padding:20rpx 0}.label{font-size:24rpx;margin-top:15rpx}.controls button{font-size:22rpx}.gap{margin-top:20rpx}
